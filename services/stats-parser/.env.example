# --- Where the dashboard webhook lives ---
WEBHOOK_URL=https://valheim-dashboard.vercel.app/api/webhook
WEBHOOK_SECRET=change-me   # must match the dashboard's WEBHOOK_SECRET

# --- Source of the .fch profiles ---
# dir  = read *.fch from a LOCAL folder — the live pipeline. Each player's
#        Valheim character files live on their own machine (the server-side
#        ServerCharacters mirror was never deployed). `_backup`/`.old` files in
#        the folder are ignored automatically.
# sftp = pull *.fch from a remote dir on the game host (unused; kept for the
#        original ServerCharacters plan).
STATS_SOURCE=dir
# Directory holding the *.fch profiles. For LOCAL Steam this is the userdata
# cloud-remote characters dir, e.g.:
#   /home/<you>/snap/steam/common/.local/share/Steam/userdata/<id>/892970/remote/characters
CHARACTERS_PATH=/home/cbspears/snap/steam/common/.local/share/Steam/userdata/84257752/892970/remote/characters

# Comma-separated allowlist of character NAMES to ingest. A Steam profile dir
# holds a lifetime of alts / singleplayer / test vikings — restrict to the ones
# that play THIS server. Empty/unset = ingest every named profile.
CHARACTERS=Chærlie,Testman,Testmantwo

# Sweep cadence in ms. The .fch only rewrites on autosave (~20 min in-game) and
# on logout, so 10–15 min is ample. --once ignores this.
POLL_INTERVAL_MS=900000

# Pin map-exploration % to the LIVE server world's UID. STRONGLY recommended:
# without it the parser reports a player's BEST-explored world, which for a
# regular is usually an old singleplayer world at ~100% — not the server.
# Read the UID from the server's worlds_local/<World>.fwl (int64, may be
# negative). The live Eilif world "Dedicated" (seed SuperSeed):
WORLD_UID=-1702040977

# --- SFTP (GTXGaming exposes SFTP on port 8822) — only for STATS_SOURCE=sftp ---
SFTP_HOST=194.50.234.131
SFTP_PORT=8822
SFTP_USER=
SFTP_PASSWORD=
SFTP_TIMEOUT_MS=15000

# --- Ops cockpit heartbeat (optional but recommended) ---
# The parser POSTs a liveness heartbeat to <dashboard>/api/ops/heartbeat after
# every sweep, with this bearer token. Unset => heartbeats are skipped entirely
# (logged once); never blocks or crashes the parser either way.
OPS_HEARTBEAT_TOKEN=
# Optional override for the heartbeat endpoint's base URL. If unset, derived by
# stripping /api/webhook off WEBHOOK_URL above.
OPS_HEARTBEAT_URL=
