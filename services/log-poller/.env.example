# Copy to .env and fill in. The .env file is gitignored.

# Source of the log: 'sftp' (live GTXGaming server) or 'file' (local, for testing)
LOG_SOURCE=sftp
# NOTE: GTXGaming nests the whole server under an instance dir named <ip>_<port>,
# so the real path is e.g. 191.101.30.229_6028/BepInEx/LogOutput.log
#
# ⚠️ LAUNCH-DAY: this and MAP_REMOTE_DIR (bottom of this file) are the two keys
# that must change when the world is renamed for the 1.0 launch world. LOG_PATH
# only carries the instance dir, so it changes if the box/port changes; the
# world name lives in MAP_REMOTE_DIR / MAP_WORLD. Get the map one wrong and the
# snapshotter silently frames the OLD world — no error, just stale frames.
LOG_PATH=191.101.30.229_6028/BepInEx/LogOutput.log

# GTXGaming SFTP (port 8822). Host/instance dir below = the current Dallas box
# (the old 194.50.234.131_5914 values were stale here until 2026-09-04).
SFTP_HOST=191.101.30.229
SFTP_PORT=8822
SFTP_USER=
SFTP_PASSWORD=
SFTP_TIMEOUT_MS=15000

# Dashboard ingestion endpoint (must match the dashboard's WEBHOOK_SECRET)
WEBHOOK_URL=https://valheim-dashboard.vercel.app/api/webhook
WEBHOOK_SECRET=

# Cadence
POLL_INTERVAL_MS=20000     # how often to fetch new log bytes (20s)
SYNC_EVERY_MS=120000       # roster reconciliation interval (2m)

# --- Server-liveness detection ---
# The live server writes a "Connections N ZDOS:" heartbeat line every ~10 min
# even with zero players. If the log stops growing for this long *while SFTP
# still connects*, the game server process is treated as DOWN: the dashboard is
# flipped offline (player count 0) and an alert is posted to Discord. A failed
# SFTP connect is a different failure and never counts as server-down.
STALE_LOG_THRESHOLD_MS=1800000     # 30 min
# While down, re-alert at most this often (the first alert is always immediate).
SERVER_DOWN_REALERT_MS=21600000    # 6 h
# Once the outage is older than 24 h the reminders back off to this interval so
# a known-dead server doesn't ping the channel four times a day.
# SERVER_DOWN_REALERT_LONG_MS=86400000   # 24 h
# Where down/up alerts go. Both optional — they default to the chat-mirror
# target below (DISCORD_TOKEN + CHAT_CHANNEL_ID, or CHAT_DISCORD_WEBHOOK), so
# no new credentials are needed. Set these only to route ops alerts elsewhere.
# ALERT_CHANNEL_ID=
# ALERT_DISCORD_WEBHOOK=

# Where to persist byte-offset + roster + liveness clock between restarts
# STATE_PATH=/home/cbspears/Projects/valheim-dashboard/services/log-poller/state.json

# Log-derived deaths: set false once GsValheimStatsClient owns death events
# (/api/gs-ingest then carries the real cause, so the two must not double-count).
EMIT_DEATHS=true

# Chat mirror (in-game shouts -> Discord, one-way). Leave all unset to disable.
# The vanilla "I have arrived!" spawn shout is filtered out before Discord.
# Preferred: a channel webhook (posts AS the player) — needs the bot to have
# Manage Webhooks, which it does NOT have as of 2026-09-04:
# CHAT_DISCORD_WEBHOOK=
# Fallback, and what is actually live: the bot token + target channel (posts as
# the bot, "🗨️ **Name:** text"). Both are set in the live .env.
DISCORD_TOKEN=
CHAT_CHANNEL_ID=

# --- Ops cockpit heartbeat (optional but recommended) ---
# The poller POSTs a liveness heartbeat (~every 60s) to <dashboard>/api/ops/heartbeat
# with this bearer token. Unset => heartbeats are skipped entirely (logged once);
# never blocks or crashes the poller either way.
OPS_HEARTBEAT_TOKEN=
# Optional override for the heartbeat endpoint's base URL. If unset, derived by
# stripping /api/webhook off WEBHOOK_URL above.
OPS_HEARTBEAT_URL=

# --- Map snapshotter (scripts/map-snapshot.mjs) ---
# map-snapshot is a separate service but reads THIS file (it loads
# services/log-poller/.env before .env.local), so its world knobs live here.
# Exactly one of the two is needed; MAP_REMOTE_DIR wins if both are set.
#
# ⚠️ LAUNCH-DAY, MUST CHANGE AT THE WORLD RENAME: the remote path ends in the
# world name. If it still points at the old world after the rename the
# snapshotter keeps succeeding against the stale files — green cockpit, frozen
# map. Change it in the same window as the wipe, then watch one 5-min cycle.
#   MAP_WORLD      — just the world-name segment (default "Dedicated"; the
#                    pilot world is EilifRehearsal, launch will be another name)
#   MAP_REMOTE_DIR — full override of the remote directory
MAP_REMOTE_DIR=/191.101.30.229_6028/BepInEx/plugins/WebMap/map_data/EilifRehearsal
# MAP_WORLD=EilifRehearsal
