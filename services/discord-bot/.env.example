# Eilif Discord bot config. Every key the live .env sets is listed here, in the
# same order, with the PILOT value the rehearsal server runs on and the LAUNCH
# value to restore for 2026-09-09. Anything marked "off by default" can be left
# out entirely. Secrets are never committed: fill them in your own .env.

DISCORD_TOKEN=
GUILD_ID=272445962654580746
CHANNEL_VALHEIM=1034118905477726279
CHANNEL_SERVER=1519437314575695984

SUPABASE_URL=https://syuwavxpmtdmxupxjzje.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

POLL_INTERVAL_MS=15000
TZ=America/Chicago

# --- The nightly recap -----------------------------------------------------
# ONE recap per day (the old 08:00 morning one is retired). Hour is local TZ.
RECAP_EVENING_HOUR=23
# Recaps stay silent until this date (server launch); event relay is unaffected.
# ⚠️ PILOT: the live .env pulls this forward (2026-07-04) so rehearsal recaps
# post. LAUNCH value is 2026-09-09.
RECAPS_START=2026-09-09
# Which channel the recap posts to: 'valheim' (default) or 'server'.
# ⚠️ PILOT OVERRIDE in the live .env is RECAP_CHANNEL=server. Revert at launch.
RECAP_CHANNEL=valheim

# --- Discord scheduled-events sync (off by default) ---
# Set EVENTS_SYNC=1 to mirror the server's Discord scheduled events to the
# dashboard's "Coming Up" sections. Needs the webhook creds below. Leave off
# while the dashboard is showing seeded demo events.
EVENTS_SYNC=0
EVENTS_INTERVAL_MS=600000
WEBHOOK_URL=https://valheim-dashboard.vercel.app/api/webhook
WEBHOOK_SECRET=

# --- Photo gallery ingest (off by default) ---
# Set GALLERY_INGEST=1 to have the bot copy images posted in Discord (that
# @mention it) into Supabase Storage + the dashboard Gallery. Uses
# SUPABASE_SERVICE_ROLE_KEY above; needs the GuildMessages intent (already set).
# The live .env runs this ON (enabled for testing 2026-06-25).
GALLERY_INGEST=0
# The only channel gallery ingest listens to (contract C). If unset, ingest
# stays ungated (any channel) — the bot logs a once-only warning.
CHANNEL_GALLERY=
# Longest edge (px) of a stored gallery photo. Every attachment is decoded,
# auto-oriented, downscaled to fit this box (never upscaled) and re-encoded as
# WebP q82 BEFORE upload — a 4 MB screenshot lands around 40-300 KB, which is
# what keeps a months-long playthrough inside the Supabase Free plan's 1 GB
# storage / 5 GB-per-month egress. Default 1600 (plenty for the grid and the
# lightbox). Raising it raises the bill; the 12 MB cap on the *download* is
# separate and hard-coded.
GALLERY_MAX_EDGE=1600

# --- The Oath ingest (off by default) ---
# Set OATH_INGEST=1 to record sworn oaths (and bio/role updates) posted in
# Discord that @mention the bot. Matches the given IN-GAME name to a roster
# viking (exact → fuzzy → unmatched). Uses SUPABASE_SERVICE_ROLE_KEY above.
OATH_INGEST=0
# Where an IN-GAME oath is cross-posted: 'valheim' (default) or 'server'.
# ⚠️ PILOT OVERRIDE in the live .env is OATH_CHANNEL=server. Revert at launch.
OATH_CHANNEL=valheim

# --- Player retellings (ON by default; TELLINGS=0 disables) ---
# `@Eilif retell <Boss>: <text>` records a viking's own account of a boss fight
# and makes it the one the war-room shows; `@Eilif tellings <Boss>` lists them
# and `@Eilif keep <Boss> <n>` chooses one. Identity-gated on the sender's
# Discord↔character link, one retell per member per 5 min. Uses
# SUPABASE_SERVICE_ROLE_KEY above and needs db/2026-09-06_boss_tellings.sql;
# before that migration is applied every verb answers "not ready" and writes
# nothing.
TELLINGS=1

# --- Tales of the hall (ALWAYS ON, and deliberately has no flag) ---
# `@Eilif tale <Title>: <text>` records a night that was not a boss (a game
# night, an RP evening) against the Central-time day it is about, and the Saga
# renders it inside that day's episode. `@Eilif tales` lists the last ten,
# `@Eilif untale <n>` withdraws one and `@Eilif retale <n>: <text>` rewrites one.
#
# There is no variable to set here. Only the Storyteller of Eilif (the office in
# db/2026-09-06_offices.sql) or a jarl (Administrator, Manage Server, or a role
# in ADMIN_ROLE_IDS above) may write one, so the office IS the gate: a hall with
# no holder and no jarl typing has no tales. Uses SUPABASE_SERVICE_ROLE_KEY and
# GUILD_ID above, and needs db/2026-09-06_tales.sql; before that migration is
# applied every verb answers "not ready" and writes nothing.

# --- Discord↔character identity link (ON by default; IDENTITY_LINK=0 disables)
# `@Eilif I am <name>` / `@Eilif join` mints a claim rune; the in-game
# `/s /oath <RUNE>` shout is what actually links it, and a 30s loop DMs the
# confirmation once the webhook consumes the claim.
IDENTITY_LINK=1

# --- Boss announcements ----------------------------------------------------
# Which channel the @everyone first-kill embed goes to: 'valheim' (default) or
# 'server'.
# ⚠️ PILOT OVERRIDE in the live .env is BOSS_CHANNEL=server. Revert at launch.
BOSS_CHANNEL=valheim

# --- The Skald (boss retellings; local Ollama) ------------------------------
# One saga retelling per newly-felled boss, best-effort, never blocking the
# announcement. The live .env pins a small always-resident model so a boss-night
# generation cannot load a big model onto the gaming GPU mid-session; manual
# regens (scripts/retell-boss.js) still default to qwen3.6:27b for prose quality.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:27b
OLLAMA_TIMEOUT_MS=150000

# --- The Voice of the Hall (off by default) ---
# Set VOICE_ENGINE=1 to run Eilif's brain: it decides what the in-game Eilif
# plugin says (the plugin polls GET /api/voice and speaks queued voice_lines).
# The live .env runs this ON.
#
# AMBIENT lines (atmosphere + callback): roughly ONE per 2 HOURS of someone-
# online time — never to an empty hall — AND never within VOICE_MIN_GAP_MS of
# the most recent voice line of ANY kind.
# DAWN lines: their own clock — once on every 3rd world day (worldDay % 3 == 0),
# only while players are online. NOT on the 2h clock, NOT gap-limited.
# EVENT lines are EXEMPT from every gap: per-player death milestones (20, 50,
# 100, then every +100 deaths), the evening POTY crown, in-game oath echoes,
# Great Deeds (see MILESTONE_MIN_GAP_MS below) and title proclamations.
# HOUSEKEEPING: a queued line nobody spoke is marked status='expired' after 24h
# (the POTY crown after 3h, because it says "tonight"), on its own 5-minute
# timer. Needs SUPABASE_SERVICE_ROLE_KEY above and the GuildMessages intent.
VOICE_ENGINE=0
# Global min-gap before an AMBIENT line may be queued, in ms (default 1800000 =
# 30 min). Measured against the newest voice_lines row of any kind, so a deed,
# title or dawn line also pushes ambient chatter back. 0 disables the gap.
VOICE_MIN_GAP_MS=1800000
# Who may puppet Eilif with `@Eilif say: <line>`: anyone with Administrator or
# Manage Server, PLUS any role id listed here (comma-separated). Needed because
# no role in the live guild actually carries the Administrator bit, so without
# this only the guild owner can use it. Everyone else gets "(admins only)".
ADMIN_ROLE_IDS=

# --- Great Deeds (collective milestones; on by default) ---
# The bot announces deeds the evaluator has stamped achieved: Discord embed AND
# the in-game voice line fire TOGETHER, in one announcement moment. Several
# deeds crossing at once are announced SEQUENTIALLY — oldest first (ties broken
# by the ladder `sort`), one per tick, nothing silenced. Set
# MILESTONES_ANNOUNCE=0 to disable.
MILESTONES_ANNOUNCE=1
# How often the announcer looks for an unannounced deed, in ms. Keep this at or
# below MILESTONE_MIN_GAP_MS — the loop is what actually paces the drain, so a
# 60s gap with a 120s loop still spaces deeds two minutes apart.
MILESTONES_INTERVAL_MS=60000
# Quiet time between two deed announcements, in ms (default 60000 = 1 min).
# The queue still drains completely; it just drains one deed per gap.
MILESTONE_MIN_GAP_MS=60000
# Which channel deeds post to: 'valheim' (default) or 'server'.
# ⚠️ PILOT OVERRIDE in the live .env is MILESTONE_CHANNEL=server — revert to
# valheim before launch.
MILESTONE_CHANNEL=valheim

# --- Living titles (on by default) ---
# Polls the dashboard's /api/titles and, when a viking's title CHANGES, posts a
# ⚔️ line to TITLE_CHANNEL and queues an in-game voice line. STICKY AND RARE
# since 2026-09-10 (Charlie: "only 2-3 title changes a night, special and
# memorable"): an EARNED title is never demoted to a placeholder, a
# placeholder->placeholder reshuffle is recorded silently, and any announced
# change needs the same offer on two passes TITLE_CONFIRM_MS apart plus (for
# earned -> earned) TITLE_MIN_TENURE_MS since the last one, capped at
# TITLES_PER_DAY proclamations per rolling 24 h. First-ever title for a viking is
# recorded SILENTLY (seed-silent) and costs no budget. TITLES_ANNOUNCE=0
# disables; TITLES_DRY=1 logs what it would say without posting or writing.
TITLES_ANNOUNCE=1
TITLES_INTERVAL_MS=600000
TITLES_DRY=0
# Proclamations allowed per rolling 24 h, counted from title_history.
TITLES_PER_DAY=3
# How long the same new title must stand before it is announced (ms, default 15 min).
TITLE_CONFIRM_MS=900000
# How long an earned title is kept before another earned title may replace it
# (ms, default 24 h). Does NOT gate a viking's FIRST earned title.
TITLE_MIN_TENURE_MS=86400000
TITLES_API_URL=https://valheim-dashboard.vercel.app/api/titles
# Where title proclamations go: 'server' (default; titles have ALWAYS posted to
# #server, so this preserves current behaviour) or 'valheim'. LAUNCH value is
# 'valheim' only if Charlie wants titles to follow deeds/oaths/recaps out of
# #server; otherwise leave it alone.
TITLE_CHANNEL=server

# --- The Skald's Chronicle (weekly; OFF by default) ---
# One embed a week to CHRONICLE_CHANNEL: the week's arrivals, hours by viking
# (top 5), deaths and their causes (top 3), kills, deeds earned, bosses felled
# with their war party, titles that changed, the Player-of-the-Day winners, and
# one line on what is next. Trailing SEVEN days, Supabase reads only, no LLM.
# Set WEEKLY_CHRONICLE=1 to turn it on; anything else (including unset) is off
# and the bot logs one line saying so at startup. It honours RECAPS_START below
# the same way the nightly recap does, so turning it on before the world opens
# cannot publish a week of pre-launch demo rows.
WEEKLY_CHRONICLE=0
# Which channel it posts to: 'valheim' (default) or 'server'.
CHRONICLE_CHANNEL=valheim
# Hour of the Sunday post, local TZ (default 20 = 8 PM Central). The DAY is
# fixed at Sunday. A second post on the same local date is refused, so a restart
# inside the posting minute cannot send the week twice.
CHRONICLE_HOUR=20

# --- Boss polls (OFF by default) ---
# When a boss flips to felled and another is still standing, the bot posts ONE
# native Discord poll naming the next objective: "Who lands first blood on
# <boss>?", single choice, 7 days, with up to 10 answers = the vikings with the
# most hours in the last 7 days. The poll id is persisted in state.json so it
# never re-posts. When that boss later falls, ONE follow-up line names the actual
# first-blood viking (bosses.fight_stats.firstBlood) and whether the hall called
# it. Turning the flag on mid-season never polls for a boss felled earlier: the
# already-felled set is seeded on the first run, like the boss watcher's. If
# that seed fails (Supabase unreachable at startup) the loop is not started for
# that run and the journal says so, rather than risking a retro poll.
BOSS_POLLS=0
# Which channel the poll + its follow-up go to: 'valheim' (default) or 'server'.
BOSS_POLL_CHANNEL=valheim
# How often the watcher looks for a newly felled boss, in ms (default 60000).
BOSS_POLLS_INTERVAL_MS=60000

# --- The Storyteller of Eilif (OFF by default) ---
# One viking keeps the tales: which telling stands on a war room page, and the
# falls nobody has told yet. `@Eilif elect storyteller` (guild admins only)
# posts a reaction ballot over every LINKED viking who has played in the last 14
# days, closes after 24 h or on `@Eilif close election`, proclaims the winner in
# Discord and in-game, and writes the term to `offices`. `@Eilif name
# storyteller <Viking>` does the same with no vote. The holder may `@Eilif keep
# <Boss> <n>` on ANY telling, not only their own, and a 30-minute loop nudges
# them once per fallen boss that no viking has told: 24 h after the kill, or 7
# days after the term opened for a boss that fell before it. That nudge is the
# ONLY place this bot mentions a real user, and it mentions exactly one.
# Needs db/2026-09-06_offices.sql; before it is applied the verbs answer "the
# ledgers are still being carved" and the loop does nothing.
STORYTELLER=0
# Which channel the ballot, the proclamation and the nudges go to: 'valheim'
# (default) or 'server'. Shared with telling votes below.
OFFICE_CHANNEL=valheim
# How often the loop closes a due ballot and owes a nudge, in ms (default
# 1800000 = 30 min). One nudge per tick at most, oldest debt first.
STORYTELLER_INTERVAL_MS=1800000

# --- Telling votes (OFF by default) ---
# When a boss has two or more tellings from the warband, the Storyteller (or a
# jarl) may call `@Eilif vote tellings <Boss>`: one reaction per telling, the
# first 300 characters of each on the ballot, closing after 24 h or on
# `@Eilif close vote <Boss>`. The winner becomes the telling the war room shows
# and is marked `canon`; the runner-up is marked `apocryphal` and gets its own
# heading on the page. One count per boss at a time, and the ballot message is
# EDITED with its result rather than answered by a second post. The Skald's own
# draft never goes on the ballot. Needs db/2026-09-06_telling_votes.sql for the
# verdicts; without it the count still rules and only the heading is missing.
TELLING_VOTES=0
TELLING_VOTES_INTERVAL_MS=1800000

# --- Altar tellings (OFF by default) ---
# A viking who walks back within 40 m of a boss altar hears the opening sentence
# of that boss's chosen telling, and who told it. The altar itself is a pin of
# kind 'boss' that /api/gs-ingest charts at the centroid of the war party the
# moment the forsaken falls; that half is ALWAYS ON and is harmless data.
#
# ⚠️ THIS LOOP DOES NOTHING WITHOUT VOICE_TARGETING=1. The line is meant for one
# viking; broadcasting a telling to the whole server because somebody wandered
# past would be the wrong message entirely, so with targeting off it enqueues
# NOTHING rather than falling back to a broadcast. The startup line says which
# of the two it is doing.
# The same viking is told at the same altar at most once every 24 h (remembered
# in state.json, bounded), and a position older than 90 s does not count as
# being there.
ALTAR_TELLINGS=0
ALTAR_INTERVAL_MS=60000

# --- Ops cockpit heartbeat (optional but recommended) ---
# The bot POSTs a liveness heartbeat (~every 60s) to <dashboard>/api/ops/heartbeat
# with this bearer token. Unset => heartbeats are skipped entirely (logged once);
# never blocks or crashes the bot either way. Status is 'degraded' when the
# gateway is not ready or an enabled sub-loop's last tick failed.
OPS_HEARTBEAT_TOKEN=
# Optional override for the heartbeat endpoint's base URL. If unset, derived by
# stripping /api/webhook off WEBHOOK_URL above.
OPS_HEARTBEAT_URL=
