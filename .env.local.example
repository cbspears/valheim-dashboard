# Eilif dashboard — local/Vercel env. Copy to .env.local and fill in.
# Values are intentionally blank here; do not commit real secrets.

# Supabase project (public — safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (server-only; bypasses RLS). Used by the ingest
# routes and by /tv's server-side reads of positions/chat.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/webhook (x-webhook-secret header).
WEBHOOK_SECRET=

# Bearer token REQUIRED on POST /api/gs-ingest for source:"server" payloads.
# The server-side GsValheimStats Emitter's config Token must equal this value.
GS_EMITTER_TOKEN=

# Bearer token REQUIRED on GET /api/boards (the in-game Living Boards signs).
# Server-only — it lives in the Valheim host's plugin config, never in a player
# pack. If UNSET the route FAILS CLOSED (503) and serves nobody.
BOARDS_TOKEN=

# Gates the /tv live-positions feed. When set, /tv only renders player positions
# for a viewer whose ?key=<value> query param matches. Leave blank to show
# positions unconditionally (pilot default).
TV_ACCESS_KEY=

# --- Ops cockpit (/admin/ops) — see docs/OPS-COCKPIT.md ---

# Password for the /admin/ops login cookie (HMAC-SHA256 signed with this
# value — no separate signing secret). If UNSET the cockpit FAILS CLOSED:
# login always rejects and the page redirects to /admin/login, never a 500.
OPS_PASSWORD=

# Bearer token producers (discord-bot, log-poller, map-snapshot, stats-parser)
# send on POST /api/ops/heartbeat. If UNSET the endpoint FAILS CLOSED (401/503)
# and never accepts a heartbeat, regardless of what token is sent.
OPS_HEARTBEAT_TOKEN=

# --- Off-PC watchdog (GET /api/ops/watchdog) ---
# Pinged every 15 min by .github/workflows/watchdog.yml so an outage is noticed
# even when the PC that runs every producer is off.

# Bearer token the external pinger must send. If UNSET the route FAILS CLOSED
# (503) and never evaluates or alerts. Must match the GitHub repository secret
# of the same name.
WATCHDOG_TOKEN=

# Discord bot token used to POST the alert (bot-token REST, no discord.js —
# this runs on Vercel). Same bot as the Discord service; it must be able to
# post in WATCHDOG_CHANNEL_ID.
DISCORD_TOKEN=

# Numeric channel id the watchdog posts alerts + all-clears to.
WATCHDOG_CHANNEL_ID=

# OPTIONAL. Prefixed to every watchdog message so it actually pings someone,
# e.g. <@123456789012345678> (user) or <@&123456789012345678> (role). Mentions
# are suppressed entirely when this is blank.
WATCHDOG_MENTION=

# OPTIONAL. Origin used for the /admin/ops link inside the Discord message.
# Defaults to https://eilif-dashboard.vercel.app.
NEXT_PUBLIC_SITE_URL=
