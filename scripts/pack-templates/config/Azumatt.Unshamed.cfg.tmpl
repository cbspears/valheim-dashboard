[1 - General]

## Master switch. Off means the mod touches nothing.
# Setting type: Toggle
# Default value: On
# Acceptable values: Off, On
Enabled = On

## The fix. Achievements.CanGetAchievements is forced true, so none of the four cheat checks can stop you earning: Game.isModded, m_usedCheats, cheated items, cheated worlds. Nothing is cleared and nothing is hidden from a server; the flags stay on disk, they just do not block achievements.
# Setting type: Toggle
# Default value: On
# Acceptable values: Off, On
Ignore Cheat Flags = On

## Show the vanilla unlock popup for each achievement the retroactive pass grants. Off because a big backlog means a lot of popups at once.
# Setting type: Toggle
# Default value: Off
# Acceptable values: Off, On
Show Popups = Off

