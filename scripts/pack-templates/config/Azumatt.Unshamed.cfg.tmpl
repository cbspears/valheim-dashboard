## Settings file was created by plugin Unshamed v1.0.0
## Plugin GUID: Azumatt.Unshamed

[1 - General]

## Master switch. Off means the mod touches nothing.
# Setting type: Toggle
# Default value: On
# Acceptable values: Off, On
Enabled = On

## Wipe the cheat flag every time a character is loaded from disk.
# Setting type: Toggle
# Default value: On
# Acceptable values: Off, On
Clear On Load = Off

## Wipe the cheat flag before the character gets written to disk. This is the one that makes it stick.
# Setting type: Toggle
# Default value: On
# Acceptable values: Off, On
Clear On Save = Off

## Wipe the flag right after a dev command sets it, so nothing ever reads it true.
# Setting type: Toggle
# Default value: On
# Acceptable values: Off, On
Clear After Command = Off

## Also zero the PlayerStatType.Cheats counter. Vanilla bumps it alongside the flag.
# Setting type: Toggle
# Default value: On
# Acceptable values: Off, On
Clear Cheat Stat = Off

## Stop Game.isModded on its own from disqualifying you. BepInEx sets that flag for every modded install, so without this nobody running mods can earn an achievement. Cheat commands, cheated items and cheated worlds still disqualify you exactly like vanilla.
# Setting type: Toggle
# Default value: On
# Acceptable values: Off, On
Ignore Modded Flag = On

## Show the vanilla unlock popup for each achievement the retroactive pass grants. Off because a big backlog means a lot of popups at once.
# Setting type: Toggle
# Default value: Off
# Acceptable values: Off, On
Show Popups = Off

[2 - Overrides]

## Comma separated Type::Method whose bool return gets forced true. A compatibility hatch for when a game patch moves something and the mod stops working.
# Setting type: String
# Default value: 
Force True Methods = 

## Same thing the other way, bool return forced false.
# Setting type: String
# Default value: 
Force False Methods = 

[3 - Retroactive]

## Automatically grant EVERY achievement your character already earned, once, next time you load into a world. Off by default, and you do not need it: 'unshamed retro' in the console previews the list and lets you pick individual ones whether this is on or off. Turn this on only if you want the lot without looking.
# Setting type: Toggle
# Default value: Off
# Acceptable values: Off, On
Enable Retroactive = Off

