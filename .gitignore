# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example templates carry no values and must ship with the repo
!.env.local.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp

# eilif-companion plugin (BepInEx / .NET build)
# Reference DLLs are re-copied from the live game + BepInEx pack via refresh-libs.sh (never committed).
plugins/eilif-companion/libs/
plugins/eilif-companion/obj/
plugins/eilif-companion/bin/
# NOTE: plugins/eilif-companion/dist/EilifCompanion.dll IS committed (the deployable artifact).
plugins/eilif-companion/.voice-token

# eilif-companion-client plugin (BepInEx / .NET build) — same convention as above.
plugins/eilif-companion-client/libs/
plugins/eilif-companion-client/obj/
plugins/eilif-companion-client/bin/
# NOTE: plugins/eilif-companion-client/dist/EilifCompanionClient.dll IS committed (the deployable artifact).

# eilif-paths plugin (BepInEx / .NET build) — same convention as above.
plugins/eilif-paths/libs/
plugins/eilif-paths/obj/
plugins/eilif-paths/bin/
# NOTE: plugins/eilif-paths/dist/EilifPaths.dll IS committed (the deployable artifact).

# eilif-boards plugin (BepInEx / .NET build) — same convention as above.
plugins/eilif-boards/libs/
plugins/eilif-boards/obj/
plugins/eilif-boards/bin/
# NOTE: plugins/eilif-boards/dist/EilifBoards.dll IS committed (the deployable artifact), and so is
# dist/media.blockspace.eilif.boards.cfg — the Token in it is the literal placeholder __BOARDS_TOKEN__,
# NEVER the real secret. Substitute at upload time only.
pilot-staging/
scripts/.map-snapshot-state.json
.claude/
